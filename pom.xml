<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.desu.cis</groupId>
  <artifactId>follow-along-5-robots</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>FollowAlong5-Robots</name>

  <!--
    Parts 21-24: students build their own robot from parts (composition), teach it
    skills (behaviors), then write robot classes that extend MBot2 (inheritance) and
    override its methods (polymorphism). Every program drives in the mbot-sim 3D viewer.

    Each part is its own package with its own main()s. Students run everything in
    IntelliJ, with the green arrow next to main(). Each Challenge.java is checked by a
    JUnit 5 test in src/test/java/partNN/ChallengeTest.java. The tests run the robot
    headless, in the world files under worlds/ (paths are relative to this folder).

    The Maven wrapper (mvnw) is here for the GitHub check, not for students.
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.0</junit.version>
    <surefire.version>3.2.5</surefire.version>
    <mbot-sim.version>1.0.0</mbot-sim.version>
  </properties>

  <!-- Where the robot simulator is downloaded from. -->
  <repositories>
    <repository>
      <id>mbot-sim</id>
      <url>https://dsu-csci-121-f26.github.io/mbot-sim/maven</url>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>edu.desu.cis</groupId>
      <artifactId>mbot-sim</artifactId>
      <version>${mbot-sim.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <!-- Tests drive the robot headless: never start the viewer or open a browser. -->
          <systemPropertyVariables>
            <mbot.viewer>off</mbot.viewer>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
